<?xml version='1.0' encoding='windows-1252'?>
<!--
  MeshPeek MSI (WiX Toolset v3), built by `cargo wix -p meshpeek-app` (see .github/workflows/release.yml).
  cargo-wix passes Version, CargoTargetBinDir and the build architecture.
  The UpgradeCode must never change: it lets new versions replace old ones.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='MeshPeek'
        UpgradeCode='B7FA6C5F-9454-4CBD-A8C3-D865C4C5216B'
        Manufacturer='MeshPeek'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package
            Id='*'
            Keywords='Installer'
            Description='MeshPeek 3D model viewer'
            Manufacturer='MeshPeek'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252' />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed.' />

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' />

        <!-- relative to this .wxs file, so it works whatever folder the build runs from -->
        <Icon Id='MeshPeekIcon' SourceFile='$(sys.SOURCEFILEDIR)..\assets\icon.ico' />
        <Property Id='ARPPRODUCTICON' Value='MeshPeekIcon' />

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='MeshPeek'>
                    <Component Id='Executable' Guid='*'>
                        <File Id='MeshPeekExe' Name='meshpeek.exe' DiskId='1' Source='$(var.CargoTargetBinDir)\meshpeek.exe' KeyPath='yes' />
                    </Component>
                    <Component Id='License' Guid='*'>
                        <File Id='License' Name='LICENSE.txt' DiskId='1' Source='$(sys.SOURCEFILEDIR)..\..\..\LICENSE' KeyPath='yes' />
                    </Component>
                    <Component Id='ThirdPartyLicenses' Guid='*'>
                        <File Id='ThirdParty' Name='THIRD-PARTY-LICENSES.html' DiskId='1' Source='$(var.CargoTargetBinDir)\THIRD-PARTY-LICENSES.html' KeyPath='yes' />
                    </Component>
                    <!-- Explorer's thumbnails: used for types no other program provides them for (SystemFileAssociations)
                         and for those MeshPeek is the default program of (MeshPeek.Model) -->
                    <Component Id='ThumbnailProvider' Guid='6E0B2C5A-9C43-4B0B-8C0E-3B5B1F0D7A94'>
                        <File Id='ThumbnailDll' Name='meshpeek_thumbs.dll' DiskId='1' Source='$(var.CargoTargetBinDir)\meshpeek_thumbs.dll' KeyPath='yes' />
                <RegistryValue Root='HKLM' Key='Software\Classes\CLSID\{8C5B6D0E-3F0A-4A3D-9B52-71D7A4C2E6F1}' Type='string' Value='MeshPeek thumbnails' />
                <RegistryValue Root='HKLM' Key='Software\Classes\CLSID\{8C5B6D0E-3F0A-4A3D-9B52-71D7A4C2E6F1}\InprocServer32' Type='string' Value='[#ThumbnailDll]' />
                <RegistryValue Root='HKLM' Key='Software\Classes\CLSID\{8C5B6D0E-3F0A-4A3D-9B52-71D7A4C2E6F1}\InprocServer32' Name='ThreadingModel' Type='string' Value='Apartment' />
                <RegistryValue Root='HKLM' Key='Software\Classes\MeshPeek.Model\shellex\{e357fccd-a995-4576-b01f-234630154e96}' Type='string' Value='{8C5B6D0E-3F0A-4A3D-9B52-71D7A4C2E6F1}' />
                <RegistryValue Root='HKLM' Key='Software\Classes\SystemFileAssociations\.stl\shellex\{e357fccd-a995-4576-b01f-234630154e96}' Type='string' Value='{8C5B6D0E-3F0A-4A3D-9B52-71D7A4C2E6F1}' />
                <RegistryValue Root='HKLM' Key='Software\Classes\SystemFileAssociations\.obj\shellex\{e357fccd-a995-4576-b01f-234630154e96}' Type='string' Value='{8C5B6D0E-3F0A-4A3D-9B52-71D7A4C2E6F1}' />
                <RegistryValue Root='HKLM' Key='Software\Classes\SystemFileAssociations\.ply\shellex\{e357fccd-a995-4576-b01f-234630154e96}' Type='string' Value='{8C5B6D0E-3F0A-4A3D-9B52-71D7A4C2E6F1}' />
                <RegistryValue Root='HKLM' Key='Software\Classes\SystemFileAssociations\.3mf\shellex\{e357fccd-a995-4576-b01f-234630154e96}' Type='string' Value='{8C5B6D0E-3F0A-4A3D-9B52-71D7A4C2E6F1}' />
                <RegistryValue Root='HKLM' Key='Software\Classes\SystemFileAssociations\.lys\shellex\{e357fccd-a995-4576-b01f-234630154e96}' Type='string' Value='{8C5B6D0E-3F0A-4A3D-9B52-71D7A4C2E6F1}' />
                <RegistryValue Root='HKLM' Key='Software\Classes\SystemFileAssociations\.chitubox\shellex\{e357fccd-a995-4576-b01f-234630154e96}' Type='string' Value='{8C5B6D0E-3F0A-4A3D-9B52-71D7A4C2E6F1}' />
                <RegistryValue Root='HKLM' Key='Software\Classes\SystemFileAssociations\.ctp\shellex\{e357fccd-a995-4576-b01f-234630154e96}' Type='string' Value='{8C5B6D0E-3F0A-4A3D-9B52-71D7A4C2E6F1}' />
                <RegistryValue Root='HKLM' Key='Software\Classes\SystemFileAssociations\.ctb\shellex\{e357fccd-a995-4576-b01f-234630154e96}' Type='string' Value='{8C5B6D0E-3F0A-4A3D-9B52-71D7A4C2E6F1}' />
                <RegistryValue Root='HKLM' Key='Software\Classes\SystemFileAssociations\.ags\shellex\{e357fccd-a995-4576-b01f-234630154e96}' Type='string' Value='{8C5B6D0E-3F0A-4A3D-9B52-71D7A4C2E6F1}' />
                    </Component>
                    <Component Id='ReplaceThumbnails' Guid='B1C7E3D2-58F4-4D0A-A6B9-0E9D4C2F7318'>
                        <RegistryValue Root='HKLM' Key='Software\MeshPeek' Name='ReplaceThumbnails' Type='integer' Value='1' KeyPath='yes' />
                    </Component>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'>
                <Component Id='StartMenuShortcut' Guid='2C151217-3FE7-42B0-8162-04FEE2737BA8'>
                    <Shortcut
                        Id='MeshPeekShortcut'
                        Name='MeshPeek'
                        Description='Fast viewer for STL, OBJ, PLY, 3MF, Lychee .lys, CHITUBOX .chitubox, .ctp and .ctb, and RuneBrace .ags files'
                        Target='[APPLICATIONFOLDER]meshpeek.exe'
                        WorkingDirectory='APPLICATIONFOLDER'
                        Icon='MeshPeekIcon' />
                    <!-- shortcuts need an HKCU key path (WiX ICE38/ICE43) -->
                    <RegistryValue Root='HKCU' Key='Software\MeshPeek' Name='StartMenuShortcut' Type='integer' Value='1' KeyPath='yes' />
                </Component>
            </Directory>
            <Directory Id='SendToFolder'>
                <Component Id='SendToShortcut' Guid='5D0C8B7E-7A55-4E5F-9C61-3B2F5D7A1E42'>
                    <Shortcut
                        Id='MeshPeekSendTo'
                        Name='MeshPeek'
                        Description='Open with MeshPeek'
                        Target='[APPLICATIONFOLDER]meshpeek.exe'
                        WorkingDirectory='APPLICATIONFOLDER'
                        Icon='MeshPeekIcon' />
                    <RegistryValue Root='HKCU' Key='Software\MeshPeek' Name='SendToShortcut' Type='integer' Value='1' KeyPath='yes' />
                </Component>
            </Directory>
        </Directory>

        <!-- Makes MeshPeek appear in "Open with" for these types. It does not touch the default program;
             that is chosen in Windows (Preferences > "Default apps…" opens the right settings page). -->
        <DirectoryRef Id='APPLICATIONFOLDER'>
            <Component Id='OpenWith' Guid='9A3E41C2-6B0D-4F7A-8E15-C2D94B7F0A36'>
                <RegistryValue Root='HKLM' Key='Software\Classes\MeshPeek.Model' Type='string' Value='3D model' KeyPath='yes' />
                <RegistryValue Root='HKLM' Key='Software\Classes\MeshPeek.Model\DefaultIcon' Type='string' Value='[APPLICATIONFOLDER]meshpeek.exe,0' />
                <RegistryValue Root='HKLM' Key='Software\Classes\MeshPeek.Model\shell\open' Name='FriendlyAppName' Type='string' Value='MeshPeek' />
                <RegistryValue Root='HKLM' Key='Software\Classes\MeshPeek.Model\shell\open\command' Type='string' Value='"[APPLICATIONFOLDER]meshpeek.exe" "%1"' />
                    <RegistryValue Root='HKLM' Key='Software\Classes\.stl\OpenWithProgids' Name='MeshPeek.Model' Type='string' Value='' />
                    <RegistryValue Root='HKLM' Key='Software\Classes\.obj\OpenWithProgids' Name='MeshPeek.Model' Type='string' Value='' />
                    <RegistryValue Root='HKLM' Key='Software\Classes\.ply\OpenWithProgids' Name='MeshPeek.Model' Type='string' Value='' />
                    <RegistryValue Root='HKLM' Key='Software\Classes\.3mf\OpenWithProgids' Name='MeshPeek.Model' Type='string' Value='' />
                    <RegistryValue Root='HKLM' Key='Software\Classes\.lys\OpenWithProgids' Name='MeshPeek.Model' Type='string' Value='' />
                    <RegistryValue Root='HKLM' Key='Software\Classes\.chitubox\OpenWithProgids' Name='MeshPeek.Model' Type='string' Value='' />
                    <RegistryValue Root='HKLM' Key='Software\Classes\.ctp\OpenWithProgids' Name='MeshPeek.Model' Type='string' Value='' />
                    <RegistryValue Root='HKLM' Key='Software\Classes\.ctb\OpenWithProgids' Name='MeshPeek.Model' Type='string' Value='' />
                    <RegistryValue Root='HKLM' Key='Software\Classes\.ags\OpenWithProgids' Name='MeshPeek.Model' Type='string' Value='' />
            </Component>
        </DirectoryRef>

        <Feature Id='Application' Title='MeshPeek' Description='The viewer.' Level='1' Absent='disallow' AllowAdvertise='no' ConfigurableDirectory='APPLICATIONFOLDER'>
            <ComponentRef Id='Executable' />
            <ComponentRef Id='License' />
            <ComponentRef Id='ThirdPartyLicenses' />
            <ComponentRef Id='StartMenuShortcut' />
            <ComponentRef Id='OpenWith' />
        </Feature>

        <Feature Id='SendTo' Title='"Send to" menu entry' Description='MeshPeek in the "Send to" menu of Explorer.' Level='1' AllowAdvertise='no'>
            <ComponentRef Id='SendToShortcut' />
        </Feature>

        <Feature Id='Thumbnails' Title='Explorer thumbnails' Level='1' AllowAdvertise='no' Display='expand'
            Description='Pictures of STL, OBJ, PLY, 3MF, LYS, CHITUBOX, CTP, CTB and AGS files in Explorer, where no other program provides them.'>
            <ComponentRef Id='ThumbnailProvider' />
            <Feature Id='ReplaceOthers' Title="Replace other programs' thumbnails" Level='1000' AllowAdvertise='no'
                Description='Use them also where another program (CHITUBOX, F3D...) provides thumbnails now. Can be undone in the Preferences of MeshPeek; uninstalling gives them back.'>
                <ComponentRef Id='ReplaceThumbnails' />
            </Feature>
        </Feature>

        <!-- for the current user, by the program: it keeps what was registered before, to give it back -->
        <CustomAction Id='TakeThumbnails' FileKey='MeshPeekExe' ExeCommand='--thumbnails replace' Execute='immediate' Return='ignore' />
        <CustomAction Id='GiveThumbnailsBack' FileKey='MeshPeekExe' ExeCommand='--thumbnails restore' Execute='immediate' Return='ignore' />
        <CustomAction Id='TellExplorer' FileKey='MeshPeekExe' ExeCommand='--thumbnails notify' Execute='immediate' Return='ignore' />
        <InstallExecuteSequence>
            <Custom Action='GiveThumbnailsBack' Before='InstallInitialize'>!ReplaceOthers=3 AND NOT UPGRADINGPRODUCTCODE AND (&amp;ReplaceOthers=2 OR REMOVE~="ALL")</Custom>
            <Custom Action='TakeThumbnails' After='InstallFinalize'>&amp;ReplaceOthers=3</Custom>
            <Custom Action='TellExplorer' After='TakeThumbnails'>NOT REMOVE~="ALL"</Custom>
        </InstallExecuteSequence>

        <UI>
            <UIRef Id='WixUI_FeatureTree' />
            <!-- no licence page -->
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>NOT Installed</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>NOT Installed</Publish>
        </UI>
    </Product>
</Wix>
